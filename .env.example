# ==============================================================================
# EduDataToBlogActions 設定テンプレート (.env)
# ==============================================================================

# --- AI (Google Gemini) 設定 ---
# Google AI Studio で取得したAPIキー (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.5-flash

# --- ブログ投稿方式の選択 ---
# 利用可能な方式:
#   - wordpress_mail (推奨: メールによる投稿 / Post by Email)
#   - wordpress_rest (WordPress REST API)
#   - markdown_only  (ブログ送信せず reports/ にマークダウン保存)
BLOG_PUBLISHER_TYPE=wordpress_mail

# --- WordPress (メール投稿方式) 設定 ---
# WordPress管理画面の「設定」>「投稿」>「メールで投稿」で発行された投稿用メールアドレス
WP_POST_EMAIL=your_secret_address@post.wordpress.com
# 投稿ステータス: 'publish' (即時公開) または 'draft' (下書き)
WP_POST_STATUS=publish
# 投稿につけるデフォルトカテゴリ（カンマ区切り）
DEFAULT_CATEGORIES=教育データ分析,情報教育,算数数学教育

# --- 送信用 SMTP 設定 (Gmailなどのメールアカウント) ---
# Gmailの場合: smtp.gmail.com / ポート 587 / Googleアカウントの「アプリパスワード(16桁)」を使用
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password

# --- WordPress (REST API方式) 設定 (BLOG_PUBLISHER_TYPE=wordpress_rest の場合) ---
WP_SITE_URL=https://your-wordpress-site.com
WP_USER=your_wp_username
WP_APP_PASSWORD=your_wp_application_password

# --- オープンデータ API 設定 (任意) ---
# e-Stat 政府統計APIキー (未設定でも内蔵マスターデータから分析可能)
ESTAT_APP_ID=

# --- 実行オプション ---
# デフォルト分析トピック: 'all', 'math' (算数・数学), 'info' (情報教育)
DEFAULT_TOPIC=all
